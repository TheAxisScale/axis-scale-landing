---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WhySection from '../components/WhySection.astro';
import TwoAnswers from '../components/TwoAnswers.astro';
import PlatformProblem from '../components/PlatformProblem.astro';
import BeforeAfterSection from '../components/BeforeAfterSection.astro';
import WhatIsInside from '../components/WhatIsInside.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import EnforcementWatch from '../components/EnforcementWatch.astro';
import PricingTiers from '../components/PricingTiers.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import CTAStrip from '../components/CTAStrip.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <WhySection />
    <TwoAnswers />
    <BeforeAfterSection />
    <WhatIsInside />
    <ProductShowcase />
    <EnforcementWatch />
    <PlatformProblem />
    <PricingTiers />
    <EarlyAccess />
