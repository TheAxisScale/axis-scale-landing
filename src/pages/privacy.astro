---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Privacy Policy - Axis-Scale">
  <main class="max-w-2xl mx-auto px-6 py-24 text-sec">
    <h1 class="text-3xl font-extrabold text-pri mb-8 tracking-tight">Privacy Policy</h1>
    <p class="text-sm text-ter mb-6">Last updated: June 2026</p>
    <p class="mb-4">Axis-Scale collects the information you provide when requesting access (name, email, company). This information is used only to respond to your request and to provide the Axis-Scale platform.</p>
    <p class="mb-4">We do not sell your data. We do not share your data with third parties except as required to operate the service (hosting infrastructure, transactional email).</p>
    <p class="mb-4">To request deletion of your data, email <a href="mailto:hello@axis-scale.com" class="text-accent hover:underline">hello@axis-scale.com</a>.</p>
  </main>
</Layout>
