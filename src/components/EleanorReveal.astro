---
const ELEANOR_FULL_NAME   = 'Eleanor Yehudai';
const ELEANOR_CREDENTIALS = 'SOC 1 · SOC 2 · ISO 27001 · GRC Leader';
const ELEANOR_BIO         = "I've spent over a decade leading security, risk, and compliance - building Pagaya's first data-security team through IPO readiness, and owning SOC 1, SOC 2, and ISO 27001 programs end-to-end. I built Axis-Scale to turn the messy, unbounded compliance scramble I kept watching founders face into something scoped, honest, and genuinely doable.";
const ELEANOR_LINKEDIN    = 'https://www.linkedin.com/in/eleanor-yehudai/';
---
<section id="about" class="py-24 px-6 md:px-9 bg-surface border-b border-[#2A3347]">
  <div class="max-w-xl mx-auto text-center">

    <p class="text-accent text-[11px] font-bold tracking-[1px] font-mono mb-10 uppercase">
      § 02 - THE BUILDER
    </p>

    <div class="flex flex-col items-center gap-5">

      <!-- Swap this monogram for a real photo: drop eleanor.jpg in /public and restore an <img>. -->
      <div class="w-24 h-24 rounded-full border-2 border-[#2A3347] bg-raised flex items-center justify-center" role="img" aria-label={ELEANOR_FULL_NAME}>
        <span class="text-2xl font-extrabold text-accent tracking-tight">EY</span>
      </div>

      <div>
        <p class="text-xl font-bold text-pri tracking-tight">{ELEANOR_FULL_NAME}</p>
        <p class="text-accent text-[11px] font-bold tracking-widest font-mono mt-1 uppercase">
          {ELEANOR_CREDENTIALS}
        </p>
      </div>

      <p class="text-sec text-sm leading-relaxed max-w-sm">
        {ELEANOR_BIO}
      </p>

      <a
        href={ELEANOR_LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
        class="text-info text-sm hover:text-pri transition-colors"
      >
        LinkedIn ↗
      </a>

    </div>

  </div>
</section>
