---
const ELEANOR_FULL_NAME   = 'Eleanor Yehudai';
const ELEANOR_CREDENTIALS = 'SOC 1 · SOC 2 · ISO 27001 · GRC Leader';
const ELEANOR_BIO         = "I've spent over a decade in security, risk, and compliance - building Pagaya's first data-security team through IPO readiness, and running SOC 1, SOC 2, and ISO 27001 programs at Safebooks AI and Pagaya. I built Axis-Scale because I kept watching founders get blindsided by compliance. It shouldn't be that hard.";
const ELEANOR_LINKEDIN    = 'https://www.linkedin.com/in/eleanor-yehudai/';
---
<section id="about" class="py-24 px-6 md:px-9 bg-light-bg border-b border-[#E0DFD9]">
  <div class="max-w-xl mx-auto text-center">

    <p class="text-accent text-[11px] font-bold tracking-[1px] font-mono mb-10 uppercase">
      § 03 - THE FOUNDER
    </p>

    <div class="flex flex-col items-center gap-5">

      <img
        src="/eleanor.jpg"
        alt={ELEANOR_FULL_NAME}
        class="w-24 h-24 rounded-full border-2 border-[#E0DFD9] object-cover object-top"
      />

      <div>
        <p class="text-xl font-bold text-on-light tracking-tight">{ELEANOR_FULL_NAME}</p>
        <p class="text-accent text-[11px] font-bold tracking-widest font-mono mt-1 uppercase">
          {ELEANOR_CREDENTIALS}
        </p>
      </div>

      <p class="text-on-light-2 text-sm leading-relaxed max-w-sm">
        {ELEANOR_BIO}
      </p>

      <a
        href={ELEANOR_LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
        class="text-info text-sm hover:text-pri transition-colors"
      >
        LinkedIn ↗
      </a>

    </div>

  </div>
</section>
