---
const steps = [
  {
    num: '01',
    title: 'Scope',
    body: 'No generic templates. We map exactly what applies to your systems, your data, your customers. Nothing you do not need.',
  },
  {
    num: '02',
    title: 'The plan',
    body: 'Every control and every gap, in the order they matter. You see the whole map before you touch a thing.',
  },
  {
    num: '03',
    title: 'What it takes',
    body: 'The full scope, sequenced and clear from day one. You see exactly what it takes before you start. No surprises, no fabrication.',
  },
];
---
<section id="how-it-works" class="py-28 px-6 md:px-16 bg-base border-b border-[#1A2030]">
  <div class="max-w-[1120px] mx-auto">

    <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-6">
      How
    </div>

    <h2 class="font-display font-[700] text-[42px] tracking-[-0.8px] leading-[1.1] text-pri mb-20 max-w-[740px]" data-animate>
      Scope first. A clear plan. Exactly what it takes, and nothing it doesn't.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12" data-animate>
      {steps.map(step => (
        <div>
          <div class="font-display text-[40px] font-[800] text-slate tracking-[-1px] leading-none">{step.num}</div>
          <div class="h-px bg-[#2A3347] my-5"></div>
          <h3 class="text-[18px] font-bold text-pri mb-3">{step.title}</h3>
          <p class="text-sec text-[15px] leading-[1.65]">{step.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
