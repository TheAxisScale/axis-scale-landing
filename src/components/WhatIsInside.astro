---
const platform = [
  'Readiness Wizard',
  'Risk Register',
  'Policy tracker with starter pack',
  'Evidence Structure',
  'Auditor Engagement Toolkit',
  'Scoped auditor portal',
  'Continuous stay-ready monitoring',
];

const expert = [
  'Stack-specific gap analysis',
  'Judgment calls on ambiguous controls',
  'Audit-ready sign-off',
  'Direct access to our team',
];
---
<section id="how-it-works" class="py-20 px-6 md:px-9 bg-surface border-y border-[#2A3347]">
  <div class="max-w-5xl mx-auto">

    <p class="text-accent text-[11px] font-bold tracking-[1px] font-mono text-center mb-4 uppercase">
      § 02 - HOW IT WORKS
    </p>
    <h2 class="text-4xl md:text-5xl font-extrabold text-pri text-center mb-14 tracking-[-0.8px] leading-[1.1]">
      Handle 80% yourself. The platform shows you how.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <div data-animate>
        <p class="text-[11px] font-bold text-ter uppercase tracking-[1px] mb-4 font-mono">Platform - self-serve</p>
        <div class="grid grid-cols-2 gap-2">
          {platform.map(name => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-raised border border-[#2A3347] text-sec text-xs font-medium">
              <span class="text-ok text-[10px] flex-shrink-0">✓</span>
              {name}
            </span>
          ))}
        </div>
      </div>

      <div data-animate>
        <p class="text-[11px] font-bold text-ter uppercase tracking-[1px] mb-4 font-mono">Expert-led add-on, an expert owns the judgment calls</p>
        <div class="grid grid-cols-2 gap-2">
          {expert.map(name => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-raised border border-[#2A3347] text-sec text-xs font-medium">
              <span class="text-info text-[10px] flex-shrink-0">✦</span>
              {name}
            </span>
          ))}
        </div>
        <a href="#early-access" class="inline-block mt-5 text-sec text-xs hover:text-pri transition-colors">
          Hand us the hard 20% →
        </a>
      </div>

    </div>

  </div>
</section>
