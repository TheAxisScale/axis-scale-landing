---
const core = [
  { name: '4-Week Sprint Roadmap',       desc: 'Week-by-week execution plan with checkpoints' },
  { name: 'Minimum Viable Checklist',    desc: '12 controls with implementation in plain English' },
  { name: "Auditor's Hit List",          desc: 'Top 5 audit findings + how to close them upfront' },
  { name: 'Risk Register Tool',          desc: 'Interactive 7-step wizard — proprietary IP' },
  { name: 'Evidence Locker + Examples',  desc: 'Folder structure + gold standard screenshots' },
  { name: 'Auditor Engagement Toolkit', desc: 'Kickoff email + Day-1 summary templates' },
];
const bonus = [
  { name: 'Auditor-to-Human Dictionary', desc: 'Plain-language translations of every audit term' },
  { name: 'Type II Continuity Pack',     desc: 'Monthly task pack — prevents post-audit collapse' },
  { name: "Do & Don't Field Guide",      desc: "War stories from the auditor's chair" },
];
---
<section class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl font-bold text-pri text-center mb-3 tracking-tight">
      What's inside
    </h2>
    <p class="text-sec text-center text-sm mb-14">
      Built from the auditor's chair — not from a template library.
    </p>

    <p class="text-xs font-bold text-ter uppercase tracking-widest mb-4">Core deliverables</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
      {core.map(item => (
        <div class="bg-surface border border-[#2A3347] rounded-[10px] p-5">
          <p class="text-accent text-[11px] font-bold uppercase tracking-wide mb-1.5">Included</p>
          <p class="font-semibold text-pri text-sm mb-1">{item.name}</p>
          <p class="text-sec text-xs leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <p class="text-xs font-bold text-ter uppercase tracking-widest mb-4">Bonus</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {bonus.map(item => (
        <div class="bg-raised border border-[#2A3347] rounded-[10px] p-5">
          <p class="text-info text-[11px] font-bold uppercase tracking-wide mb-1.5">Bonus</p>
          <p class="font-semibold text-pri text-sm mb-1">{item.name}</p>
          <p class="text-sec text-xs leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
