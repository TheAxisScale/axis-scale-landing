---
const SIGNUP_URL = 'https://app.axis-scale.com/register';
---
<section class="py-36 px-6 md:px-16 bg-base border-t border-[#1A2030]">
  <div class="max-w-5xl mx-auto">

    <h2 class="font-display font-[900] text-[48px] md:text-[54px] tracking-[-1.2px] leading-[1.05] text-pri max-w-[660px] mb-7" data-animate>
      You already made the decision. Now grab the wheel.
    </h2>

    <p class="text-sec text-[18px] leading-[1.65] mb-11 max-w-[460px]" data-animate>
      No demo gauntlet. No sales call required to begin.
    </p>

    <div data-animate>
      <a
        href={SIGNUP_URL}
        class="inline-flex items-center px-8 py-4 bg-accent hover:bg-accent-hover text-white font-semibold text-[15px] rounded-full transition-colors"
      >
        Start your assessment
      </a>
    </div>

  </div>
</section>
