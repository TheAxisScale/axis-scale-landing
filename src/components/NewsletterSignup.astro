---
// Public newsletter signup. Posts email + source to the Axis backend's public
// endpoint (same backend/CORS the EnforcementWatch widget already uses).
const API_BASE = 'https://backend-production-2d08.up.railway.app';
---
<section id="newsletter" class="py-24 px-6 md:px-9 bg-surface border-y border-border">
  <div class="max-w-xl mx-auto text-center">
    <p class="text-slate text-[11px] font-bold tracking-[1px] font-mono mb-4 uppercase">
      Stay informed
    </p>
    <h2 class="text-3xl font-extrabold text-pri mb-3 tracking-[-0.6px] leading-[1.1]">
      Regulatory and enforcement updates
    </h2>
    <p class="text-sec text-sm mb-8">
      GDPR enforcement, the EU AI Act, US state privacy laws, and more. No spam.
    </p>

    <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <input id="nl-email" name="email" type="email" required placeholder="you@company.com"
        class="flex-1 bg-raised border border-border rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"/>
      <button type="submit"
        class="inline-flex items-center justify-center px-6 py-3 bg-accent hover:bg-accent-hover text-white font-bold text-sm rounded-[var(--radius-pill)] transition-colors disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap">
        Subscribe &#8594;
      </button>
    </form>

    <p id="nl-success" class="hidden text-ok text-sm font-medium pt-4">
      You are on the list. We will send regulatory and enforcement updates.
    </p>
    <p id="nl-error" class="hidden text-err text-sm pt-4">
      Something went wrong. Try again in a moment.
    </p>
  </div>
</section>

<script define:vars={{ API_BASE }}>
  const form = document.getElementById('newsletter-form');
  const btn  = form.querySelector('button[type="submit"]');
  const ok   = document.getElementById('nl-success');
  const err  = document.getElementById('nl-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    ok.classList.add('hidden');
    err.classList.add('hidden');
    const email = document.getElementById('nl-email').value.trim();
    try {
      const res = await fetch(API_BASE + '/api/public/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'website' }),
      });
      if (res.ok) {
        form.reset();
        form.classList.add('hidden');
        ok.classList.remove('hidden');
      } else {
        err.classList.remove('hidden');
      }
    } catch {
      err.classList.remove('hidden');
    } finally {
      btn.disabled = false;
    }
  });
</script>
