---
const excuses = [
  {
    quote: '"We\'ll start when a customer asks."',
    retort: 'Sure. SOC 2 takes months. Customers give you a week. Do the math.',
  },
  {
    quote: '"Nobody\'s asked us yet."',
    retort: 'They asked. They asked the vendor that had it.',
  },
  {
    quote: '"No budget right now."',
    retort: 'The demo you gave last Tuesday cost more, and it\'s going nowhere without a cert.',
  },
  {
    quote: '"It\'s on the roadmap."',
    retort: 'So is your customer\'s decision date. Guess which one moves.',
  },
];
---
<section id="why" class="py-28 px-6 md:px-16 bg-base border-b border-[#1A2030]">
  <div class="max-w-[1120px] mx-auto">

    <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-6">
      Sound familiar?
    </div>

    <h2 class="font-display font-[700] text-[42px] tracking-[-0.8px] leading-[1.1] text-pri mb-14 max-w-[640px]" data-animate>
      Things founders tell us every week.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {excuses.map(item => (
        <div class="rounded-[14px] border border-[#2A3347] bg-surface p-8" data-animate>
          <p class="text-pri text-[19px] font-bold tracking-[-0.3px] mb-3">{item.quote}</p>
          <p class="text-sec text-[15px] leading-[1.65]">{item.retort}</p>
        </div>
      ))}
    </div>

  </div>
</section>
