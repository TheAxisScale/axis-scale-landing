---
const rows = [
  { label: 'Effort',  old: 'A standing project',       next: 'A finite, scoped list' },
  { label: 'Cost',    old: 'Five figures, at minimum',  next: 'One transparent founding rate' },
  { label: 'Method',  old: 'Generic templates',         next: 'Scoped to your systems' },
  { label: 'Output',  old: 'A binder no one reads',     next: 'An audit-ready register', highlight: true },
];
---
<section class="py-28 px-6 md:px-16 bg-base border-b border-[#1A2030]">
  <div class="max-w-4xl mx-auto">

    <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-6">
      The difference
    </div>

    <h2 class="font-display font-[700] text-[42px] tracking-[-0.8px] leading-[1.1] text-pri mb-14 max-w-[680px]" data-animate>
      Same outcome. A fraction of the cost and the effort.
    </h2>

    <div class="rounded-[14px] border border-[#2A3347] overflow-hidden" data-animate>

      <!-- Header row -->
      <div class="grid grid-cols-[100px_1fr_auto_1fr] items-center bg-raised px-8 py-4 border-b border-[#2A3347]">
        <div></div>
        <div class="text-[11px] font-bold tracking-[1px] uppercase font-mono text-ter">The old way</div>
        <div class="w-6"></div>
        <div class="text-[11px] font-bold tracking-[1px] uppercase font-mono text-accent">With Axis-Scale</div>
      </div>

      {rows.map((row, i) => (
        <div class={`grid grid-cols-[100px_1fr_auto_1fr] items-center px-8 py-5 ${i < rows.length - 1 ? 'border-b border-[#2A3347]' : ''}`}>
          <div class="text-[11px] font-bold tracking-[0.8px] uppercase font-mono text-ter">{row.label}</div>
          <div class="text-[15px] text-sec line-through decoration-[#3A4660]">{row.old}</div>
          <div class="text-accent font-bold px-3 text-base">&#8594;</div>
          <div class={`text-[15px] font-semibold ${row.highlight ? 'text-accent' : 'text-pri'}`}>{row.next}</div>
        </div>
      ))}

    </div>

  </div>
</section>
