---
const rows = [
  { label: 'Effort',  old: 'A standing project',         new: 'A finite, scoped list' },
  { label: 'Cost',    old: 'Six figures in consulting',   new: 'One transparent founding rate' },
  { label: 'Method',  old: 'Generic templates',           new: 'Scoped to your systems' },
  { label: 'Output',  old: 'A binder no one reads',       new: 'An audit-ready register', highlight: true },
];
---
<section class="py-28 px-6 md:px-16 bg-base border-b border-[#1A2030]">
  <div class="max-w-5xl mx-auto">

    <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-6">
      The difference
    </div>

    <h2 class="font-display font-[700] text-[42px] tracking-[-0.8px] leading-[1.1] text-pri mb-14 max-w-[680px]" data-animate>
      Same outcome. A fraction of the cost and the effort.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-animate>

      <!-- The old way -->
      <div class="rounded-[10px] px-9 pt-9 pb-3" style="background:#E7EAEF; color:#0A0E14;">
        <div class="text-[11px] font-bold uppercase tracking-[1px] font-mono mb-6" style="color:#6E7681;">The old way</div>
        {rows.map(row => (
          <div class="flex justify-between gap-4 py-[18px]" style="border-top:1px solid #cfd5dd;">
            <span class="text-sm" style="color:#6E7681;">{row.label}</span>
            <span class="text-[15px] font-semibold text-right">{row.old}</span>
          </div>
        ))}
      </div>

      <!-- Axis-Scale -->
      <div class="rounded-[10px] px-9 pt-9 pb-3 border border-[#2A3347]" style="background:#161B27;">
        <div class="text-slate text-[11px] font-bold uppercase tracking-[1px] font-mono mb-6">Axis-Scale</div>
        {rows.map(row => (
          <div class="flex justify-between gap-4 py-[18px] border-t border-[#2A3347]">
            <span class="text-sm text-sec">{row.label}</span>
            <span class={`text-[15px] font-semibold text-right ${row.highlight ? 'text-accent' : 'text-pri'}`}>{row.new}</span>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
