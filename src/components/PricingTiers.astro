---
const SIGNUP_URL = 'https://app.axis-scale.com/register';

const platformFeatures = [
  'Readiness wizard',
  'Risk register',
  'Policy tracker with starter pack',
  'Evidence structure',
  'Scoped auditor portal',
  'Stay-ready monitoring: daily regulatory scan across your in-scope frameworks',
];
---
<section id="pricing" class="py-24 px-6 md:px-16 bg-surface border-y border-[#2A3347]">
  <div class="max-w-[1120px] mx-auto">

    <p class="text-slate text-[11px] font-bold tracking-[1px] font-mono text-center mb-4 uppercase">
      PLANS
    </p>
    <h2 class="font-display font-[700] text-[38px] tracking-[-0.8px] leading-[1.1] text-pri text-center mb-4">
      The bottom line. All of it.
    </h2>
    <p class="text-sec text-center text-[15px] mb-14 max-w-md mx-auto">
      "What do I actually pay out of my pocket?" Here. On the page. Including the auditor.
    </p>

    <!-- Lanes 1–3 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

      <!-- Lane 1 -->
      <div class="bg-base border border-[#2A3347] rounded-[14px] p-8 flex flex-col">
        <p class="text-ter text-[11px] font-bold tracking-[1px] font-mono uppercase mb-5">LANE 1</p>
        <h3 class="text-xl font-bold text-pri mb-2 tracking-[-0.3px]">Platform only</h3>
        <p class="text-xs text-ter mb-4">Monthly · no commitment · no expert support</p>
        <div class="mb-8">
          <div class="flex items-baseline gap-0.5">
            <span class="text-[32px] font-extrabold text-pri tracking-[-1px] leading-none">$249</span>
            <span class="text-sm text-ter">/mo</span>
          </div>
          <p class="text-[11px] text-ter font-mono mt-1.5">billed annually</p>
        </div>
        <ul class="space-y-3 mb-8 flex-1">
          {platformFeatures.map(f => (
            <li class="flex items-start gap-2.5 text-sm text-sec">
              <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a href="#early-access" class="block text-center py-3 px-4 rounded-full text-sm font-bold bg-accent hover:bg-accent-hover text-white transition-colors">
          Get started →
        </a>
      </div>

      <!-- Lane 2 - recommended -->
      <div class="bg-base border-2 border-accent rounded-[14px] p-8 flex flex-col relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
          <span class="text-[10px] font-bold tracking-[0.5px] font-mono uppercase px-3 py-1 rounded-full bg-accent text-white whitespace-nowrap">Most recommended</span>
        </div>
        <p class="text-ter text-[11px] font-bold tracking-[1px] font-mono uppercase mb-5">LANE 2</p>
        <h3 class="text-xl font-bold text-pri mb-2 tracking-[-0.3px]">Platform + audit blitz</h3>
        <p class="text-xs text-ter mb-4">Monthly platform · 4-week expert blitz before audit · 1-year commitment · fixed price and scope</p>
        <div class="mb-8 space-y-1.5">
          <div class="flex items-baseline gap-0.5">
            <span class="text-[32px] font-extrabold text-pri tracking-[-1px] leading-none">$249</span>
            <span class="text-sm text-ter">/mo</span>
            <span class="text-xs text-ter ml-1.5">platform</span>
          </div>
          <div class="flex items-baseline gap-0.5">
            <span class="text-[32px] font-extrabold text-pri tracking-[-1px] leading-none">$4,000</span>
            <span class="text-xs text-ter ml-1.5">expert blitz</span>
          </div>
          <p class="text-[11px] text-ter font-mono pt-0.5">~$7,000 in year one</p>
        </div>
        <ul class="space-y-3 mb-8 flex-1">
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Everything in Lane 1
          </li>
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            4-week expert-led audit blitz
          </li>
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Fixed scope and fixed price
          </li>
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Audit-ready sign-off from our team
          </li>
        </ul>
        <a href="#early-access" class="block text-center py-3 px-4 rounded-full text-sm font-bold bg-accent hover:bg-accent-hover text-white transition-colors">
          Book your expert sign-off →
        </a>
      </div>

      <!-- Lane 3 -->
      <div class="bg-base border border-[#2A3347] rounded-[14px] p-8 flex flex-col">
        <p class="text-ter text-[11px] font-bold tracking-[1px] font-mono uppercase mb-5">LANE 3</p>
        <h3 class="text-xl font-bold text-pri mb-2 tracking-[-0.3px]">2-year commitment</h3>
        <div class="space-y-2 mb-3">
          <div class="rounded-md bg-raised border border-[#2A3347] px-3 py-2.5">
            <p class="text-[10px] font-bold text-ter font-mono uppercase mb-1">Year 1</p>
            <p class="text-xs text-sec mb-1.5">Platform + 4-week expert blitz before audit</p>
            <p class="text-xs text-pri font-semibold">$249/mo + $4,000 blitz</p>
          </div>
          <div class="rounded-md bg-raised border border-[#2A3347] px-3 py-2.5">
            <p class="text-[10px] font-bold text-accent font-mono uppercase mb-1">Year 2 · 30% off expert fee</p>
            <p class="text-xs text-sec mb-1.5">Same platform + blitz package, 30% off the expert fee</p>
            <p class="text-xs text-pri font-semibold">$249/mo + $2,800 blitz</p>
          </div>
        </div>
        <p class="text-[11px] text-ter font-mono mb-8">~$12,800 over two years</p>
        <ul class="space-y-3 mb-8 flex-1">
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Everything in Lane 2, both years
          </li>
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Locked rates for 2 years
          </li>
          <li class="flex items-start gap-2.5 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            30% off Year 2 expert fee
          </li>
        </ul>
        <a href="#early-access" class="block text-center py-3 px-4 rounded-full text-sm font-semibold bg-transparent hover:bg-raised text-pri border-[1.5px] border-[#2A3347] hover:border-pri transition-colors">
          Book your expert sign-off →
        </a>
      </div>

    </div>

    <!-- Lane 4 banner -->
    <div class="bg-base border border-[#2A3347] rounded-[14px] px-8 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <p class="text-ter text-[11px] font-bold uppercase tracking-[1px] font-mono mb-1">LANE 4</p>
        <p class="text-pri font-semibold text-[15px] tracking-[-0.2px]">Scoped for you</p>
        <p class="text-sec text-xs mt-1 max-w-lg">Your stack, your timeline, your requirements. We scope the engagement together and give you a fixed price before any work starts.</p>
      </div>
      <a href="#early-access" class="shrink-0 inline-flex items-center px-5 py-2.5 text-sm font-semibold text-pri border border-[#2A3347] hover:border-pri rounded-full transition-colors whitespace-nowrap">
        Reach out →
      </a>
    </div>

    <p class="text-ter text-[13px] text-center mt-8 max-w-xl mx-auto">
      Being "already in progress" costs $249.
    </p>

  </div>
</section>

<!-- Floating third-party costs card: visible only while #pricing is in view -->
<aside
  id="third-party-float"
  aria-label="Third-party costs"
  class="fixed bottom-6 left-6 z-40 max-w-[340px] bg-raised border border-dashed border-[#3A4660] rounded-[14px] px-6 py-5 shadow-2xl opacity-0 translate-y-3 pointer-events-none transition-all duration-300 hidden md:block"
>
  <button
    id="third-party-float-close"
    aria-label="Dismiss"
    class="absolute top-3 right-3 text-ter hover:text-pri text-sm leading-none transition-colors"
  >&#x2715;</button>
  <p class="text-ter text-[10px] font-bold uppercase tracking-[1px] font-mono mb-1.5 pr-5">Third-party costs, so you can budget the whole thing</p>
  <p class="text-pri font-semibold text-[14px] tracking-[-0.2px] mb-2">The audit and the penetration test</p>
  <p class="text-[22px] font-extrabold text-pri tracking-[-1px] leading-none whitespace-nowrap mb-1.5">$10,000 - $15,000</p>
  <p class="text-[11px] text-ter font-mono mb-2">together, depending on scope and complexity</p>
  <p class="text-sec text-xs">Paid directly to an independent CPA firm and a pen-testing team.</p>
</aside>

<script>
  const float = document.getElementById('third-party-float');
  const closeBtn = document.getElementById('third-party-float-close');
  const pricing = document.getElementById('pricing');
  let dismissed = false;

  const show = () => {
    if (dismissed) return;
    float.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
  };
  const hide = () => {
    float.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
  };

  if (float && pricing) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => (e.isIntersecting ? show() : hide())),
      { threshold: 0.12 }
    );
    obs.observe(pricing);

    closeBtn?.addEventListener('click', () => {
      dismissed = true;
      hide();
    });
  }
</script>
