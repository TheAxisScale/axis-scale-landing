---
const SIGNUP_URL         = '[SIGNUP_URL]';
const BOOKING_URL        = '[BOOKING_URL]';
const SELF_SERVE_PRICE   = '[SELF_SERVE_PRICE]';
const ESCALATION_PRICE   = '[ESCALATION_PRICE]';
const ELEANOR_FIRST_NAME = '[ELEANOR_FIRST_NAME]';
---
<section id="pricing" class="py-20 px-6 bg-surface border-y border-[#2A3347]">
  <div class="max-w-4xl mx-auto">

    <p class="text-ter text-[11px] font-bold tracking-widest font-mono text-center mb-4 uppercase">
      § 04 — PRICING
    </p>
    <h2 class="font-display text-3xl text-pri text-center mb-3 tracking-tight">
      Two ways in.
    </h2>
    <p class="text-sec text-center text-sm mb-14">
      Start self-serve and move at your own pace, or work directly with {ELEANOR_FIRST_NAME} for the parts that need a human.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- Door 1 -->
      <div class="bg-base border border-[#2A3347] rounded-[14px] p-7 flex flex-col">
        <p class="text-ter text-[11px] font-bold tracking-widest font-mono uppercase mb-4">DOOR 1</p>
        <h3 class="text-xl font-bold text-pri mb-1">Start self-serve</h3>
        <p class="text-4xl font-extrabold text-pri tracking-tight mt-2 mb-1">{SELF_SERVE_PRICE}</p>
        <p class="text-xs text-ter mb-7">Platform access · move at your own pace</p>
        <ul class="space-y-3 mb-8 flex-1">
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Readiness wizard
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Risk register
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Policy templates
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Evidence structure
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Auditor engagement toolkit
          </li>
        </ul>
        <a
          href={SIGNUP_URL}
          class="block text-center py-3 px-4 rounded-md text-sm font-bold bg-accent hover:bg-accent-hover text-white transition-colors"
        >
          Get started →
        </a>
      </div>

      <!-- Door 2 -->
      <div class="bg-base border border-[#2A3347] rounded-[14px] p-7 flex flex-col">
        <p class="text-ter text-[11px] font-bold tracking-widest font-mono uppercase mb-4">DOOR 2</p>
        <h3 class="text-xl font-bold text-pri mb-1">Work with {ELEANOR_FIRST_NAME}</h3>
        <p class="text-4xl font-extrabold text-pri tracking-tight mt-2 mb-1">{ESCALATION_PRICE}</p>
        <p class="text-xs text-ter mb-7">Expert-led · the judgment-heavy 20%</p>
        <ul class="space-y-3 mb-8 flex-1">
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Stack-specific gap analysis
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Judgment calls on ambiguous controls
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Audit-ready sign-off
          </li>
          <li class="flex items-start gap-2 text-sm text-sec">
            <span class="text-ok mt-0.5 flex-shrink-0">✓</span>
            Direct access to {ELEANOR_FIRST_NAME}
          </li>
        </ul>
        <a
          href={BOOKING_URL}
          class="block text-center py-3 px-4 rounded-md text-sm font-bold bg-raised hover:bg-muted text-pri border border-[#2A3347] transition-colors"
        >
          Book a call →
        </a>
      </div>

    </div>
  </div>
</section>
