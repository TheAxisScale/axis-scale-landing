---
const pains = [
  {
    title: 'The 70/30 Surprise',
    body: "Founders expect a tech audit. It's 70% process and documentation. Most discover this mid-engagement — after they've already paid.",
  },
  {
    title: 'Evidence Chaos',
    body: '300+ hours collecting screenshots with no clear standard for what counts. Every auditor wants something slightly different.',
  },
  {
    title: 'The Unbounded Unknown',
    body: "You can't size it, so you can't budget, plan, or give your prospect a date. The fear isn't the work — it's not knowing how big the work is.",
  },
];
---
<section id="why" class="py-20 px-6 bg-surface border-y border-[#2A3347]">
  <div class="max-w-6xl mx-auto">

    <p class="text-ter text-[11px] font-bold tracking-widest font-mono text-center mb-4 uppercase">
      § 01 — WHY FOUNDERS GET STUCK
    </p>
    <h2 class="text-2xl font-bold text-pri text-center mb-12 tracking-tight">
      Three places every founder hits a wall
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pains.map(p => (
        <div class="bg-raised border border-[#2A3347] rounded-[10px] p-6">
          <h3 class="font-bold text-pri mb-3">{p.title}</h3>
          <p class="text-sec text-sm leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
