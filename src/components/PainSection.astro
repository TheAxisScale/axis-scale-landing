---
const pains = [
  {
    title: 'The 70/30 Surprise',
    body: "The audit is 70% process, 30% tech. Most founders discover this mid-engagement, after they've already paid.",
  },
  {
    title: 'Evidence Chaos',
    body: '300+ hours with no standard for what counts. Every auditor wants something slightly different.',
  },
  {
    title: 'The Unbounded Unknown',
    body: "You can't size it, so you can't budget, plan, or give your prospect a timeline.",
  },
];
---
<section id="why" class="py-24 px-6 md:px-9 bg-surface border-y border-[#2A3347]">
  <div class="max-w-6xl mx-auto">

    <p class="text-accent text-[11px] font-bold tracking-[1px] font-mono text-center mb-4 uppercase">
      § 01 - WHY FOUNDERS GET STUCK
    </p>
    <h2 class="text-4xl md:text-5xl font-extrabold text-pri text-center mb-14 tracking-[-0.8px] leading-[1.1]">
      Three things nobody warns you about SOC 2
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pains.map(p => (
        <div class="border border-[#2A3347] rounded-[14px] p-7 hover:border-[rgba(233,30,140,0.5)] transition-colors" style="background: linear-gradient(to bottom, rgba(233,30,140,0.05) 0%, #1E2538 40%); border-top-color: rgba(233,30,140,0.3);">
          <h3 class="font-bold text-pri mb-3 text-lg tracking-[-0.2px]">{p.title}</h3>
          <p class="text-sec text-sm leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
