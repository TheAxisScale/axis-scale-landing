---
const SIGNUP_URL  = 'https://app.axis-scale.com/register';
const BOOKING_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ3_5A5BbXDJwZmrDUAoBpz4uVfSHA0F7vGQUcv7wiLbchVaHA0fUhBECYjGIlvx6hQoamt4lDpz?gv=true';
const ELEANOR_FIRST_NAME  = 'Eleanor';
const ELEANOR_FULL_NAME   = 'Eleanor Yehudai';
const ELEANOR_CREDENTIALS = "who's taken companies through SOC 1, SOC 2 & ISO 27001";
---
<section class="pt-24 pb-20 px-6 md:px-9">
  <div class="max-w-4xl mx-auto text-center">

    <!-- Pill eyebrow badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-dim border border-accent-border mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
      <span class="text-accent text-[11px] font-bold tracking-[.8px] uppercase font-mono">
        SOC 2 · ISO · NIST · GDPR - READINESS, SCOPED
      </span>
    </div>

    <h1 class="text-5xl md:text-7xl font-extrabold text-pri tracking-[-1.5px] leading-[1.02] mb-6 max-w-4xl mx-auto">
      Stop guessing -
      <span class="text-accent"> gain certainty and control</span>
      over your compliance program.
    </h1>

    <p class="text-sec text-lg leading-relaxed mb-3 max-w-2xl mx-auto">
      Turn that unknown into a bounded, scoped, costed plan. Self-serve most of it at your own pace - bring in expert help for the hard part.
    </p>

    <p class="text-ter text-sm mb-10">
      Built by <span class="text-sec font-medium">{ELEANOR_FULL_NAME}</span>, {ELEANOR_CREDENTIALS}.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={SIGNUP_URL}
        class="inline-flex items-center px-6 py-3 bg-accent hover:bg-accent-hover text-white font-bold text-sm rounded-full transition-colors w-full sm:w-auto justify-center tracking-[-0.1px]"
      >
        Start self-serve
      </a>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-6 py-3 bg-transparent hover:bg-raised border-[1.5px] border-[#2A3347] hover:border-pri text-pri font-semibold text-sm rounded-full transition-colors w-full sm:w-auto justify-center"
      >
        Work with {ELEANOR_FIRST_NAME}
      </a>
    </div>

  </div>
</section>
