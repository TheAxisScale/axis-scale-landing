---
const SIGNUP_URL  = 'https://app.axis-scale.com/register';
const BOOKING_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ3_5A5BbXDJwZmrDUAoBpz4uVfSHA0F7vGQUcv7wiLbchVaHA0fUhBECYjGIlvx6hQoamt4lDpz?gv=true';
const ELEANOR_FIRST_NAME  = 'Eleanor';
const ELEANOR_FULL_NAME   = 'Eleanor Yehudai';
const ELEANOR_CREDENTIALS = "who's taken companies through SOC 1, SOC 2 & ISO 27001";
---
<section class="pt-24 pb-20 px-6 md:px-9" style="background-image: radial-gradient(ellipse 80% 55% at 50% -5%, rgba(233,30,140,0.15) 0%, transparent 60%), radial-gradient(rgba(255,255,255,0.055) 1px, transparent 1px); background-size: auto, 32px 32px;">
  <div class="max-w-4xl mx-auto text-center">

    <!-- Pill eyebrow badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-dim border border-accent-border mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
      <span class="text-accent text-[11px] font-bold tracking-[.8px] uppercase font-mono">
        SOC 2 READINESS · SCOPED, NOT GUESSED
      </span>
    </div>

    <h1 class="font-extrabold tracking-[-1.5px] mb-6 max-w-4xl mx-auto text-center">
      <span class="block text-3xl md:text-[42px] text-pri leading-[1.3] opacity-75">Stop staring down the SOC 2 pit,</span>
      <span class="block text-3xl md:text-[42px] text-pri leading-[1.3] opacity-75">guessing how deep it goes.</span>
      <span class="block text-4xl md:text-[50px] text-accent leading-[1.2] mt-3">I've been there.</span>
      <span class="block text-4xl md:text-[50px] text-pri leading-[1.2]">Here's the map.</span>
      <span class="block text-5xl md:text-[58px] text-accent leading-[1.15]">Grab the wheel.</span>
    </h1>

    <p class="text-sec text-lg leading-relaxed mb-10 max-w-2xl mx-auto">
      You handle most of it at your own pace - and bring in expert help for the part that needs a human.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={SIGNUP_URL}
        class="inline-flex items-center px-6 py-3 bg-accent hover:bg-accent-hover text-white font-bold text-sm rounded-full transition-colors w-full sm:w-auto justify-center tracking-[-0.1px]"
      >
        Start self-serve
      </a>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-6 py-3 bg-transparent hover:bg-raised border-[1.5px] border-[#2A3347] hover:border-pri text-pri font-semibold text-sm rounded-full transition-colors w-full sm:w-auto justify-center"
      >
        Work with us
      </a>
    </div>

  </div>
</section>
