---
const SIGNUP_URL = 'https://app.axis-scale.com/register';
---
<section class="pt-32 pb-36 px-6 md:px-16 bg-base border-b border-[#1A2030]">
  <div class="max-w-5xl mx-auto">

    <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-7">
      SOC 2 readiness
    </div>

    <h1 class="font-display font-[900] text-[58px] md:text-[68px] tracking-[-1.5px] leading-[1.04] text-pri max-w-[760px] mb-8">
      Stop improvising compliance.
    </h1>

    <p class="text-sec text-[18px] leading-[1.65] mb-11 max-w-[540px]">
      You decided this matters. See the plan, the scope, and exactly what it takes. Clear from day one.
    </p>

    <div class="flex items-center gap-6">
      <a
        href={SIGNUP_URL}
        class="inline-flex items-center px-7 py-3.5 bg-accent hover:bg-accent-hover text-white font-semibold text-[15px] rounded-full transition-colors"
      >
        Start your assessment
      </a>
      <a href="#how-it-works" class="text-sec text-sm font-semibold hover:text-pri transition-colors">
        See how it works ↓
      </a>
    </div>

  </div>
</section>
