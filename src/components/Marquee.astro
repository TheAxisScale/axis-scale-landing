---
const items = [
  'AUDITOR-BUILT',
  'FOUNDER-PRICED',
  'SCOPED, NOT GUESSED',
  'AN EXPERT SIGNS OFF',
  'NO FABRICATED EVIDENCE',
  'READY BY AUDIT DAY',
];
const track = [...items, ...items];
---
<div class="border-y border-[#2A3347] overflow-hidden py-3 bg-surface" style="-webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%)">
  <div class="marquee-track flex gap-10 whitespace-nowrap">
    {track.map(item => (
      <span class="text-ter text-[11px] font-bold tracking-widest font-mono shrink-0">{item}</span>
    ))}
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 32s linear infinite;
    width: max-content;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
