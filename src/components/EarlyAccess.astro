---
const FORMSPREE_ID = 'xlgkbbdr';
---
<section id="early-access" class="py-24 px-6 md:px-9 bg-surface border-y border-[#2A3347]">
  <div class="max-w-xl mx-auto">

    <p class="text-slate text-[11px] font-bold tracking-[1px] font-mono text-center mb-6 uppercase">
      Early Access
    </p>

    <!-- Idle mascot: 4 logo tiles + Axie climb loop -->
    <div id="axie-idle" class="flex flex-col items-center mb-6">
      <!-- Axis·Scale wordmark -->
      <svg width="120" height="20" viewBox="0 0 120 20" fill="none" aria-hidden="true" class="mb-4">
        <text x="0" y="16"
          font-family="Inter, system-ui, sans-serif"
          font-size="14" font-weight="800" letter-spacing="-0.5" fill="#E6EDF3">
          Axis<tspan font-weight="500" fill="#8B949E">&#xB7;Scale</tspan>
        </text>
      </svg>

      <!-- 4-tile logo mark with Axie climb animation -->
      <svg width="120" height="110" viewBox="0 0 120 110" fill="none" style="overflow:visible;" aria-hidden="true">
        <!-- top-left tile -->
        <rect x="38" y="6" width="20" height="20" rx="3.5" fill="#3A4660"/>
        <!-- bottom-left tile -->
        <rect x="38" y="30" width="20" height="20" rx="3.5" fill="#2A3347"/>
        <!-- bottom-right tile -->
        <rect x="62" y="30" width="20" height="20" rx="3.5" fill="#3A4660"/>
        <!-- Axie: top-right tile, 6s climb loop -->
        <g style="transform-box:fill-box;transform-origin:center;animation:axClimb 6s ease-in-out infinite">
          <rect x="62" y="6" width="20" height="20" rx="3.5" fill="#E91E8C"/>
          <!-- Left eye (cx = tile_center_x - 4.5 = 72 - 4.5 = 67.5) -->
          <circle cx="67.5" cy="13" r="1.75" fill="#fff"/>
          <!-- Right eye (cx = tile_center_x + 4.5 = 72 + 4.5 = 76.5) -->
          <circle cx="76.5" cy="13" r="1.75" fill="#fff"
            style="transform-box:fill-box;transform-origin:center;animation:axWinkLoop 6s ease-in-out infinite"/>
          <!-- Smile: centered at x=72 (start=65=72-7, end=79=72+7) -->
          <path d="M65 17.5 q7 4 14 0" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round"
            style="opacity:0;animation:axSmile 6s ease-in-out infinite"/>
        </g>
      </svg>
    </div>

    <!-- Done mascot: celebratory state (shown on submit) -->
    <div id="axie-done" class="hidden justify-center mb-6">
      <svg width="72" height="90" viewBox="0 -16 64 80" fill="none" style="overflow:visible;" aria-hidden="true">
        <g transform="translate(9,1)"><path d="M0 -3.4L1 -1L3.4 0L1 1L0 3.4L-1 1L-3.4 0L-1 -1Z" fill="#fff"
          style="transform-box:fill-box;transform-origin:center;animation:axSpark 2.8s ease-in-out 0s infinite"/></g>
        <g transform="translate(55,4)"><path d="M0 -2.8L.8 -.8L2.8 0L.8 .8L0 2.8L-.8 .8L-2.8 0L-.8 -.8Z" fill="#E91E8C"
          style="transform-box:fill-box;transform-origin:center;animation:axSpark 2.8s ease-in-out .18s infinite"/></g>
        <g transform="translate(53,52)"><path d="M0 -2.6L.7 -.7L2.6 0L.7 .7L0 2.6L-.7 .7L-2.6 0L-.7 -.7Z" fill="#fff"
          style="transform-box:fill-box;transform-origin:center;animation:axSpark 2.8s ease-in-out .32s infinite"/></g>
        <g style="transform-box:fill-box;transform-origin:center;animation:axPop 2.8s ease-in-out infinite">
          <rect x="6" y="6" width="52" height="52" rx="13" fill="#E91E8C"/>
          <g style="animation:axOpenFade 2.8s ease-in-out infinite">
            <circle cx="25" cy="30" r="4.2" fill="#fff"/>
            <circle cx="39" cy="30" r="4.2" fill="#fff"/>
            <path d="M26 40q6 4.5 12 0" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round"/>
          </g>
          <g style="animation:axHappyFade 2.8s ease-in-out infinite">
            <path d="M21 31q4-5 8 0" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round"/>
            <path d="M35 31q4-5 8 0" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round"/>
            <path d="M24 39q8 6 16 0" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round"/>
          </g>
        </g>
      </svg>
    </div>

    <h2 class="text-4xl font-extrabold text-pri text-center mb-3 tracking-[-0.8px] leading-[1.1]">
      Talk to us about your SOC 2
    </h2>
    <p class="text-sec text-center text-sm mb-10">
      Tell us where you are in the process. We will scope it together and point you at the right door.
    </p>

    <form id="early-access-form" class="flex flex-col gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="ea-name" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Name *</label>
          <input id="ea-name" name="name" type="text" required placeholder="Your name"
            class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"/>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="ea-email" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Email *</label>
          <input id="ea-email" name="email" type="email" required placeholder="you@company.com"
            class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"/>
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="ea-company" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Company</label>
        <input id="ea-company" name="company" type="text" placeholder="Company name"
          class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"/>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="ea-message" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Where are you in the process?</label>
        <textarea id="ea-message" name="message" rows="3"
          placeholder="e.g. Just got a customer asking for SOC 2, no idea where to start..."
          class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors resize-none"></textarea>
      </div>

      <button type="submit"
        class="mt-2 inline-flex items-center justify-center px-7 py-3.5 bg-accent hover:bg-accent-hover text-white font-bold text-sm rounded-full transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Request early access &#8594;
      </button>

      <p id="ea-success" class="hidden text-center text-ok text-sm font-medium pt-1">
        Got it - we will be in touch.
      </p>
      <p id="ea-error" class="hidden text-center text-err text-sm pt-1">
        Something went wrong. Email <a href="mailto:hello@axis-scale.com" class="underline">hello@axis-scale.com</a> directly.
      </p>
    </form>

  </div>
</section>

<script define:vars={{ FORMSPREE_ID }}>
  const form = document.getElementById('early-access-form');
  const btn  = form.querySelector('button[type="submit"]');
  const ok   = document.getElementById('ea-success');
  const err  = document.getElementById('ea-error');
  const idle = document.getElementById('axie-idle');
  const done = document.getElementById('axie-done');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    ok.classList.add('hidden');
    err.classList.add('hidden');
    try {
      const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      });
      if (res.ok) {
        form.reset();
        ok.classList.remove('hidden');
        idle.classList.add('hidden');
        done.classList.remove('hidden');
        done.classList.add('flex');
      } else {
        err.classList.remove('hidden');
      }
    } catch {
      err.classList.remove('hidden');
    } finally {
      btn.disabled = false;
    }
  });
</script>
