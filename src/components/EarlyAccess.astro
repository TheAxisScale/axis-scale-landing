---
const FORMSPREE_ID  = 'xlgkbbdr';
const BOOKING_URL   = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ3_5A5BbXDJwZmrDUAoBpz4uVfSHA0F7vGQUcv7wiLbchVaHA0fUhBECYjGIlvx6hQoamt4lDpz?gv=true';
---
<section id="early-access" class="py-24 px-6 md:px-9 bg-surface border-y border-[#2A3347]">
  <div class="max-w-xl mx-auto">

    <p class="text-accent text-[11px] font-bold tracking-[1px] font-mono text-center mb-4 uppercase">
      § 05 - EARLY ACCESS
    </p>
    <h2 class="text-4xl font-extrabold text-pri text-center mb-3 tracking-[-0.8px] leading-[1.1]">
      Not sure which path fits?
    </h2>
    <p class="text-sec text-center text-sm mb-10">
      Request a short walkthrough. Eleanor will reach out to help you figure out where you stand and what makes sense for your timeline.
    </p>
    <p class="text-ter text-center text-xs mb-8">
      Prefer to skip the form?
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Book a call directly →</a>
    </p>

    <form
      id="early-access-form"
      class="flex flex-col gap-4"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="ea-name" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Name *</label>
          <input
            id="ea-name"
            name="name"
            type="text"
            required
            placeholder="Your name"
            class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="ea-email" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Email *</label>
          <input
            id="ea-email"
            name="email"
            type="email"
            required
            placeholder="you@company.com"
            class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="ea-company" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Company</label>
        <input
          id="ea-company"
          name="company"
          type="text"
          placeholder="Company name"
          class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="ea-message" class="text-ter text-xs font-bold uppercase tracking-widest font-mono">Where are you in the process?</label>
        <textarea
          id="ea-message"
          name="message"
          rows="3"
          placeholder="e.g. Just got a customer asking for SOC 2, no idea where to start..."
          class="bg-raised border border-[#2A3347] rounded-md px-4 py-2.5 text-pri text-sm placeholder:text-ter focus:outline-none focus:border-accent transition-colors resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-2 inline-flex items-center justify-center px-7 py-3.5 bg-accent hover:bg-accent-hover text-white font-bold text-sm rounded-full transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Request early access →
      </button>

      <p id="ea-success" class="hidden text-center text-ok text-sm font-medium pt-1">
        Got it - Eleanor will be in touch.
      </p>
      <p id="ea-error" class="hidden text-center text-err text-sm pt-1">
        Something went wrong. Email <a href="mailto:hello@axis-scale.com" class="underline">hello@axis-scale.com</a> directly.
      </p>
    </form>

  </div>
</section>

<script define:vars={{ FORMSPREE_ID }}>
  const form = document.getElementById('early-access-form');
  const btn  = form.querySelector('button[type="submit"]');
  const ok   = document.getElementById('ea-success');
  const err  = document.getElementById('ea-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    ok.classList.add('hidden');
    err.classList.add('hidden');

    try {
      const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      });
      if (res.ok) {
        form.reset();
        ok.classList.remove('hidden');
      } else {
        err.classList.remove('hidden');
      }
    } catch {
      err.classList.remove('hidden');
    } finally {
      btn.disabled = false;
    }
  });
</script>
