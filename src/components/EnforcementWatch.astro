---
// Public read-only API of the risk-register backend (Railway).
// Source: risk-register-saas/README.md ("Backend: https://backend-production-2d08.up.railway.app")
const API_BASE = 'https://backend-production-2d08.up.railway.app';
---
<!--
  Resilience contract: this section renders hidden (class "hidden").
  It only becomes visible after the enforcement endpoint returns at least
  one signal. Any fetch error, non-200, or empty list means it stays
  display:none forever. A marketing page never shows an empty box.
-->
<section id="enforcement" class="hidden py-28 px-6 md:px-16 bg-base border-b border-[#1A2030]">
  <div class="max-w-[1120px] mx-auto">

    <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-6">
      Enforcement watch &middot; Live from our regulatory agent
    </div>

    <h2 class="font-display font-[700] text-[42px] tracking-[-0.8px] leading-[1.1] text-pri mb-7 max-w-[640px]" data-animate>
      Fines handed out while founders were "getting to it."
    </h2>

    <p class="text-sec text-[18px] leading-[1.7] mb-14 max-w-[640px]" data-animate>
      Our regulatory agent reads the enforcement dockets every morning so you don't have to pretend you do. Recent fines, straight from the sources.
    </p>

    <!-- Top 3 enforcement actions, built client-side -->
    <div id="ew-fines" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12"></div>

    <!-- Slim general feed (non-enforcement signals) -->
    <div id="ew-feed-wrap" class="hidden mb-12">
      <div class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono mb-2">
        Also on the wire
      </div>
      <div id="ew-feed"></div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center gap-5">
      <p class="text-pri text-[17px] font-semibold">
        This feed also runs inside the platform, wired to your risk register.
      </p>
      <a href="#early-access"
        class="inline-flex items-center self-start px-7 py-3.5 bg-accent hover:bg-accent-hover text-white font-bold text-sm rounded-full transition-colors whitespace-nowrap">
        Get my audit date &#8594;
      </a>
    </div>

  </div>
</section>

<script define:vars={{ API_BASE }}>
  (function () {
    const section  = document.getElementById('enforcement');
    const finesBox = document.getElementById('ew-fines');
    const feedWrap = document.getElementById('ew-feed-wrap');
    const feedBox  = document.getElementById('ew-feed');
    if (!section || !finesBox || !feedWrap || !feedBox) return;

    // All API-provided strings go through textContent, never innerHTML.
    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    }

    function fmtFine(raw) {
      const n = Number(raw);
      if (!isFinite(n) || n <= 0) return null;
      const compact = (v) => {
        const r = Math.round(v * 10) / 10;
        return String(Number.isInteger(r) ? Math.round(r) : r);
      };
      if (n >= 1e9) return '$' + compact(n / 1e9) + 'B';
      if (n >= 1e6) return '$' + compact(n / 1e6) + 'M';
      if (n >= 1e3) return '$' + compact(n / 1e3) + 'K';
      return '$' + Math.round(n);
    }

    // Honest timestamps: always the report date, never "today".
    // Year is appended when it is not the current year.
    function fmtDate(raw) {
      if (!raw) return '';
      const d = new Date(raw);
      if (isNaN(d.getTime())) return '';
      const opts = { month: 'short', day: 'numeric', timeZone: 'UTC' };
      if (d.getUTCFullYear() !== new Date().getUTCFullYear()) opts.year = 'numeric';
      return d.toLocaleDateString('en-US', opts);
    }

    function safeUrl(raw) {
      return typeof raw === 'string' && /^https?:\/\//i.test(raw) ? raw : null;
    }

    const TAG_CLASS = 'inline-block px-2 py-0.5 rounded border border-[#2A3347] bg-raised text-[10px] font-mono font-medium uppercase tracking-[1px] text-slate';

    function buildFineCard(signal) {
      const card = el('div', 'rounded-[14px] border border-[#2A3347] bg-surface p-7 flex flex-col gap-3');

      const meta = el('div', 'flex items-center gap-2 flex-wrap');
      if (signal.legalDomain)  meta.appendChild(el('span', TAG_CLASS, signal.legalDomain));
      if (signal.jurisdiction) meta.appendChild(el('span', TAG_CLASS, signal.jurisdiction));
      const date = fmtDate(signal.reportDate);
      if (date) meta.appendChild(el('span', 'ml-auto text-ter text-[11px] font-mono', date));
      if (meta.childNodes.length) card.appendChild(meta);

      const amount = fmtFine(signal.fineAmountUsd);
      if (amount) {
        card.appendChild(el('div', 'font-display font-[800] text-[40px] leading-none tracking-[-1px] text-accent', amount));
        card.appendChild(el('p', 'text-pri text-[16px] font-bold tracking-[-0.2px]', signal.finedEntity || signal.title || ''));
      } else {
        // No dollar figure on record: the signal title leads instead.
        card.appendChild(el('p', 'text-pri text-[17px] font-bold tracking-[-0.2px] leading-[1.35]', signal.title || signal.finedEntity || ''));
      }

      if (signal.summary) card.appendChild(el('p', 'text-sec text-[14px] leading-[1.6] truncate', signal.summary));

      const url = safeUrl(signal.sourceUrl);
      if (url) {
        const link = el('a', 'mt-auto text-slate hover:text-accent text-[12px] font-mono transition-colors', 'Source ↗');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener';
        card.appendChild(link);
      }
      return card;
    }

    function buildFeedRow(signal) {
      const row = el('div', 'flex items-center gap-4 border-t border-[#1A2030] py-3');
      row.appendChild(el('p', 'text-sec text-[14px] truncate min-w-0 flex-1', signal.title || ''));
      const right = el('div', 'flex items-center gap-2 shrink-0');
      if (signal.legalDomain) right.appendChild(el('span', TAG_CLASS, signal.legalDomain));
      const date = fmtDate(signal.reportDate);
      if (date) right.appendChild(el('span', 'text-ter text-[11px] font-mono', date));
      row.appendChild(right);
      return row;
    }

    async function getSignals(path) {
      const res = await fetch(API_BASE + path, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      if (Array.isArray(data)) return data;
      return Array.isArray(data && data.signals) ? data.signals : [];
    }

    (async () => {
      let fines;
      try {
        fines = await getSignals('/api/public/regulatory-signals/enforcement?limit=3');
      } catch {
        return; // API down or missing: section stays hidden.
      }
      fines = fines.slice(0, 3);
      if (fines.length === 0) return; // No data: section stays hidden.

      fines.forEach((s) => finesBox.appendChild(buildFineCard(s)));

      // The general feed is best-effort: its failure never hides the section.
      try {
        const all = await getSignals('/api/public/regulatory-signals?limit=8');
        const rest = all
          .filter((s) => !String(s.signalType || '').toLowerCase().includes('enforcement'))
          .slice(0, 5);
        if (rest.length) {
          rest.forEach((s) => feedBox.appendChild(buildFeedRow(s)));
          feedWrap.classList.remove('hidden');
        }
      } catch {
        // Feed stays hidden; fines cards still show.
      }

      section.classList.remove('hidden');
    })();
  })();
</script>
