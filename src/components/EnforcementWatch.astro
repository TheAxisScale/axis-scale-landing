---
// Public read-only API of the risk-register backend (Railway).
// Source: risk-register-saas/README.md ("Backend: https://backend-production-2d08.up.railway.app")
const API_BASE = 'https://backend-production-2d08.up.railway.app';
---
<!--
  Resilience contract: this strip renders hidden (class "hidden").
  It only becomes visible after the enforcement endpoint returns at least
  one signal. Any fetch error, non-200, or empty list means it stays
  display:none forever. A marketing page never shows an empty box.
-->
<div id="enforcement" class="hidden bg-surface border-b border-border-light px-6 md:px-16 py-5">
  <div class="max-w-[1120px] mx-auto flex flex-col sm:flex-row sm:items-center gap-3">

    <div class="flex-1 min-w-0">
      <span class="text-slate text-[11px] font-bold tracking-[1.4px] uppercase font-mono">
        Enforcement watch
      </span>
      <span id="ew-headline" class="ml-3 text-pri text-[14px] font-semibold truncate"></span>
    </div>

    <a href="#early-access"
      class="shrink-0 text-accent text-[13px] font-semibold hover:underline whitespace-nowrap">
      Subscribe to alerts &#8594;
    </a>

  </div>
</div>

<script define:vars={{ API_BASE }}>
  (function () {
    const strip    = document.getElementById('enforcement');
    const headline = document.getElementById('ew-headline');
    if (!strip || !headline) return;

    async function getSignals(path) {
      const res = await fetch(API_BASE + path, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      if (Array.isArray(data)) return data;
      return Array.isArray(data && data.signals) ? data.signals : [];
    }

    (async () => {
      let fines;
      try {
        fines = await getSignals('/api/public/regulatory-signals/enforcement?limit=1');
      } catch {
        return; // API down or missing: strip stays hidden.
      }
      if (!fines.length) return; // No data: strip stays hidden.

      const s = fines[0];
      const label = s.finedEntity || s.title || '';
      if (label) headline.textContent = label;

      strip.classList.remove('hidden');
    })();
  })();
</script>
